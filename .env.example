# App
APP_SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://logbook.example.com

# Database password -- deploy.sh uses this to start the Postgres container
# and to build DATABASE_URL automatically. You don't need to set
# DATABASE_URL yourself for the real deploy; deploy.sh does that.
POSTGRES_PASSWORD=change-me

# Google Maps Platform -- Geocoding API (server-side only, the key never
# reaches the browser). Create a project at console.cloud.google.com,
# enable "Geocoding API", create an API key restricted to your server's
# public IP address. Leave blank to run without address lookups -- trips
# still work fine, start/end addresses just won't be filled in (SARS does
# not require an address, only the odometer/km/purpose).
GOOGLE_MAPS_API_KEY=

# South African tax year start (1 March by default) -- only change this if
# you have a real reason to.
TAX_YEAR_START_MONTH=3
TAX_YEAR_START_DAY=1
